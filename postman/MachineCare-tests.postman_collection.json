{
  "info": {
    "name": "MachineCare - scénario API",
    "description": "Tests manuels du login, de l'inscription, du CRUD machines et du cycle de vie des incidents. Importer puis exécuter dans l'ordre.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "change_me_to_a_secure_password" },
    { "key": "token", "value": "" },
    { "key": "machineId", "value": "" },
    { "key": "incidentId", "value": "" }
  ],
  "item": [
    {
      "name": "1 - Login compte par défaut",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status attendu: 200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
    },
    {
      "name": "2 - Inscription (route peut être absente)",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Inscription: attendu 201', () => pm.response.to.have.status(201));"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"test-machinecare@example.com\",\n  \"password\": \"motdepasse123\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }
    },
    {
      "name": "3 - Machines: accès sans token (401 attendu)",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Protection JWT: 401', () => pm.response.to.have.status(401));"] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/machines" }
    },
    {
      "name": "4 - Créer machine",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Création machine: 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('machineId', pm.response.json()._id);"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Pompe hydraulique\",\n  \"code\": \"PMP-001\",\n  \"type\": \"Pompe\",\n  \"location\": \"Atelier A\"\n}" }, "url": "{{baseUrl}}/api/machines" }
    },
    {
      "name": "5 - Lister machines",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Liste machines: 200', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/machines?status=operational" }
    },
    {
      "name": "6 - Modifier machine",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Modification machine: 200', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"maintenance\"\n}" }, "url": "{{baseUrl}}/api/machines/{{machineId}}" }
    },
    {
      "name": "7 - Déclarer incident",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Déclaration incident: 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('incidentId', pm.response.json()._id);"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"machine\": \"{{machineId}}\",\n  \"description\": \"Vibration anormale sur la pompe\",\n  \"severity\": \"high\"\n}" }, "url": "{{baseUrl}}/api/incidents" }
    },
    {
      "name": "8 - Résoudre sans note (400 attendu)",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Note obligatoire: 400', () => pm.response.to.have.status(400));"] } }],
      "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"resolved\"\n}" }, "url": "{{baseUrl}}/api/incidents/{{incidentId}}/status" }
    },
    {
      "name": "9 - Résoudre avec note",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Résolution: 200', () => pm.response.to.have.status(200));"] } }],
      "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"resolved\",\n  \"resolutionNote\": \"Joint remplacé et fonctionnement vérifié\"\n}" }, "url": "{{baseUrl}}/api/incidents/{{incidentId}}/status" }
    },
    {
      "name": "10 - Route inexistante (404 attendu)",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 attendu', () => pm.response.to.have.status(404));"] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/route-inexistante" }
    }
  ]
}
